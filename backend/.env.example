# ─── Configuración de entorno ────────────────────────────────────────────────
# Copiar como .env y completar con valores reales

# Django
SECRET_KEY=django-insecure-CAMBIAR-POR-CLAVE-SEGURA-EN-PRODUCCION
DEBUG=True

# Hosts permitidos (separados por coma). '*' = sin validación de Host, para
# que la tablet pueda llamar a la API por la IP LAN de la PC servidor (ver
# docs/pwa_tablet.md). Reemplazar por la IP/hostname fijo si se define uno.
ALLOWED_HOSTS=*

# CORS — IPs de la red local WiFi del negocio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.0:5173
CORS_ALLOW_ALL_ORIGINS=True

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_NAME=ceramica_db
DB_USER=ceramica_user
DB_PASSWORD=ceramica_pass_segura
DB_HOST=localhost
DB_PORT=5432

# ─── Datos fiscales (facturación) ────────────────────────────────────────────
# Sin estos datos las FACTURAS salen sin RUC ni timbrado y no sirven. Los
# tickets no los usan. Para ver qué falta:  python manage.py verificar_fiscal
# El detalle de dónde sacar cada uno está en docs/facturacion_electronica.md
FISCAL_RUC=
FISCAL_RAZON_SOCIAL=
FISCAL_DIRECCION=
FISCAL_TELEFONO=
FISCAL_TIMBRADO=
FISCAL_TIMBRADO_VTO=

# Componen el número de comprobante y el CDC. Tienen que coincidir EXACTAMENTE
# con lo habilitado en el RUC. e-Kuatia'i exige un único establecimiento y un
# único punto de expedición.
FISCAL_ESTABLECIMIENTO=001
FISCAL_PUNTO_EXPEDICION=001
# 1 = persona física, 2 = persona jurídica
FISCAL_TIPO_CONTRIBUYENTE=2

# Domicilio codificado — solo lo exige el documento electrónico, no el ticket.
# Son códigos de las tablas del DNIT, no texto libre.
FISCAL_DEPARTAMENTO=
FISCAL_DEPARTAMENTO_DESC=
FISCAL_DISTRITO=
FISCAL_DISTRITO_DESC=
FISCAL_CIUDAD=
FISCAL_CIUDAD_DESC=
FISCAL_ACTIVIDAD_CODIGO=
FISCAL_ACTIVIDAD_DESC=

# ─── SIFEN / e-Kuatia ────────────────────────────────────────────────────────
# Mientras SIFEN_HABILITADO=False el sistema factura como siempre: no emite
# documentos electrónicos y no sale a internet. Prender recién cuando estén
# el certificado y la habilitación del DNIT.
SIFEN_HABILITADO=False
SIFEN_AMBIENTE=test

# Certificado cualificado de firma (.p12). Lo entrega el DNIT sin costo.
# NUNCA versionar este archivo ni su clave.
SIFEN_CERT_PATH=
SIFEN_CERT_PASSWORD=

# Sidecar Node con la suite facturacionelectronicapy-* (ver el doc)
SIFEN_SIDECAR_URL=http://127.0.0.1:8100
SIFEN_TIMEOUT=30
SIFEN_MAX_INTENTOS=10
SIFEN_MINUTOS_REINTENTO=5

# ─── Impresora A4 Epson EcoTank L1250 ────────────────────────────────────────
# NO es la impresora de facturas: el comprobante fiscal sale por su propio
# equipo. Esta imprime las etiquetas de código de barras (y cualquier PDF que
# haga falta sacar en hoja).
# El nombre tiene que ser EXACTO al de Panel de control → Dispositivos e
# impresoras. `python diagnostico_impresora.py` lista las instaladas.
IMPRESORA_A4_NOMBRE=EPSON L1250 Series
# manual = se imprime desde el navegador (anda siempre)
# auto   = la manda el servidor solo (requiere Adobe Reader instalado)
IMPRESORA_A4_MODO=manual
IMPRESORA_A4_COPIAS=1

# ─── Identidad de este equipo en la red ──────────────────────────────────────
# Cómo lo encuentran los demás: GET /api/v1/salud/ devuelve estos datos y es
# lo que permite buscar al servidor por nombre en vez de por IP.
# Ver docs/descubrimiento_red.md
#
# NODO_ROL: 'servidor' = la PC del local (la que manda).
#           'notebook' = el equipo de la propietaria.
# El rol NO es cosmético: los clientes exigen rol='servidor' antes de
# sincronizar, así la notebook nunca se sincroniza contra sí misma.
NODO_ROL=servidor

# Nombre de red del equipo. Vacío = el hostname de Windows.
NODO_NOMBRE=

# SSID de la red WiFi del local. Lo usa el agente de sync de la notebook para
# saber si está adentro del predio antes de intentar conectarse.
RED_WIFI_LOCAL=OGA PORA

# ─── Sincronización notebook ↔ servidor ──────────────────────────────────────
# Secreto compartido: TIENE que ser el MISMO en la PC servidor y en la
# notebook. Vacío = los endpoints de sync quedan cerrados.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ver docs/sync_bidireccional.md
SYNC_TOKEN=
