# ─── Configuración de entorno ────────────────────────────────────────────────
# Copiar como .env y completar con valores reales

# Django
SECRET_KEY=django-insecure-CAMBIAR-POR-CLAVE-SEGURA-EN-PRODUCCION
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS — IPs de la red local WiFi del negocio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.0:5173
CORS_ALLOW_ALL_ORIGINS=True

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_NAME=ceramica_db
DB_USER=ceramica_user
DB_PASSWORD=ceramica_pass_segura
DB_HOST=localhost
DB_PORT=5432
