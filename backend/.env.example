# ─── Configuración de entorno ────────────────────────────────────────────────
# Copiar como .env y completar con valores reales

# Django
SECRET_KEY=django-insecure-CAMBIAR-POR-CLAVE-SEGURA-EN-PRODUCCION
DEBUG=True

# Hosts permitidos (separados por coma). '*' = sin validación de Host, para
# que la tablet pueda llamar a la API por la IP LAN de la PC servidor (ver
# docs/pwa_tablet.md). Reemplazar por la IP/hostname fijo si se define uno.
ALLOWED_HOSTS=*

# CORS — IPs de la red local WiFi del negocio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.0:5173
CORS_ALLOW_ALL_ORIGINS=True

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_NAME=ceramica_db
DB_USER=ceramica_user
DB_PASSWORD=ceramica_pass_segura
DB_HOST=localhost
DB_PORT=5432

# ─── Datos fiscales (facturación) ────────────────────────────────────────────
# Sin estos datos las FACTURAS salen sin RUC ni timbrado y no sirven. Los
# tickets no los usan. Para ver qué falta:  python manage.py verificar_fiscal
# El detalle de dónde sacar cada uno está en docs/facturacion_electronica.md
FISCAL_RUC=
FISCAL_RAZON_SOCIAL=
FISCAL_DIRECCION=
FISCAL_TELEFONO=
FISCAL_TIMBRADO=
FISCAL_TIMBRADO_VTO=

# Contacto que va al pie de la Nota de Pedido. NO son los fiscales de arriba:
# el teléfono y la dirección que se le dan al cliente en un presupuesto son
# distintos de los que la DNIT tiene registrados para la factura. Si se dejan
# vacíos, el sistema usa los de la nota que el negocio ya venía usando.
CONTACTO_EMAIL=
CONTACTO_TELEFONO=
CONTACTO_DIRECCION=

# Componen el número de comprobante y el CDC. Tienen que coincidir EXACTAMENTE
# con lo habilitado en el RUC. e-Kuatia'i exige un único establecimiento y un
# único punto de expedición.
FISCAL_ESTABLECIMIENTO=001
FISCAL_PUNTO_EXPEDICION=001
# 1 = persona física, 2 = persona jurídica
FISCAL_TIPO_CONTRIBUYENTE=2

# Domicilio codificado — solo lo exige el documento electrónico, no el ticket.
# Son códigos de las tablas del DNIT, no texto libre.
FISCAL_DEPARTAMENTO=
FISCAL_DEPARTAMENTO_DESC=
FISCAL_DISTRITO=
FISCAL_DISTRITO_DESC=
FISCAL_CIUDAD=
FISCAL_CIUDAD_DESC=
FISCAL_ACTIVIDAD_CODIGO=
FISCAL_ACTIVIDAD_DESC=

# ─── SIFEN / e-Kuatia ────────────────────────────────────────────────────────
# Mientras SIFEN_HABILITADO=False el sistema factura como siempre: no emite
# documentos electrónicos y no sale a internet. Prender recién cuando estén
# el certificado y la habilitación del DNIT.
SIFEN_HABILITADO=False
SIFEN_AMBIENTE=test

# Certificado cualificado de firma (.p12). Lo entrega el DNIT sin costo.
# NUNCA versionar este archivo ni su clave.
# Código de Seguridad del Contribuyente, del PDF de la habilitación.
# Firma el QR del KuDE. Es secreto: no versionar.
SIFEN_CSC_ID=
SIFEN_CSC=
SIFEN_CERT_PATH=
SIFEN_CERT_PASSWORD=

# Sidecar Node con la suite facturacionelectronicapy-* (ver el doc)
SIFEN_SIDECAR_URL=http://127.0.0.1:8100
SIFEN_TIMEOUT=30
SIFEN_MAX_INTENTOS=10
SIFEN_MINUTOS_REINTENTO=5
