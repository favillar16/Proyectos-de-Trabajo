# Carpetas de dependencias (Node.js, Python, etc.)
node_modules/
venv/

# Bytecode compilado de Python (binario, específico de cada máquina)
__pycache__/
*.pyc

# Archivos de configuración con claves/secretos
.env

# Archivos generados por el sistema operativo
.DS_Store
Thumbs.db

# Registros y logs
*.log

# Artefacto generado por Vite/PWA en modo desarrollo, se regenera solo
frontend/dev-dist/

# Sync notebook — credenciales y datos locales de cada máquina, no van al repo
sync_notebook/config.env
sync_notebook/tmp/
sync_notebook/estado/

# Service worker de PWA generado por Vite en modo dev, no es código fuente
frontend/dev-dist/