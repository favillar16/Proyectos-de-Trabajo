# Carpetas de dependencias (Node.js, Python, etc.)
node_modules/
venv/

# Bytecode compilado de Python (binario, específico de cada máquina)
__pycache__/
*.pyc

# Archivos de configuración con claves/secretos
.env

# Archivos generados por el sistema operativo
.DS_Store
Thumbs.db

# Registros y logs
*.log

# Artefacto generado por Vite/PWA en modo desarrollo, se regenera solo
frontend/dev-dist/

# Sync notebook — credenciales y datos locales de cada máquina, no van al repo
sync_notebook/config.env
sync_notebook/tmp/
sync_notebook/estado/
sync_notebook/logs/

# Fotos que dejan los tests (config/settings_test.py apunta MEDIA_ROOT aca).
backend/media_test/

# Registro de cambios del sync: es estado de ESTE equipo, no del proyecto.
# Cada notebook y el servidor tienen el suyo (ver apps/sync/routers.py).
backend/sync.sqlite3

# Respaldos del sistema (base de datos + fotos de productos). Son datos del
# negocio, no código — ver docs/respaldo_y_migracion.md
respaldos/
# Respaldo de la base enviado fuera del repo para el traslado (datos del negocio)
docs/*.zip

# Accesos directos de Windows: dependen de la ruta de cada maquina
*.lnk


# Credenciales de PostgreSQL de esta instalacion (superusuario y rol del sync).
# Nunca deben entrar al repositorio: el historial de git es permanente.
credenciales_servidor.txt
sync_notebook/credenciales_sync.txt

# Estaticos recolectados por collectstatic: se regeneran, no son fuente
backend/staticfiles/

# Certificado cualificado de firma electronica del DNIT. Es la identidad
# fiscal del negocio: quien lo tenga puede emitir facturas a su nombre.
# Nunca al repositorio — el historial de git es permanente.
*.p12
*.pfx

# La habilitacion como facturador electronico trae el Codigo de Seguridad del
# Contribuyente (CSC) impreso. El CSC firma el QR del KuDE: quien lo tenga puede
# emitir documentos a nombre del negocio. Vale lo mismo que el certificado.
# El resto del contenido de ese PDF esta transcripto en
# docs/carga_final/datos_fiscales.md, que si se versiona.
TIMBRADO FACTURADOR ELECTRONICO*.pdf
