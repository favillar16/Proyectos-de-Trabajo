# ─── Configuración del sync de la notebook ───────────────────────────────────
# Copiar este archivo como "config.env" en esta misma carpeta y completar con
# los datos reales. "config.env" NO se sube al repositorio (contiene
# contraseñas) — ver .gitignore.
#
# Este archivo se completa UNA VEZ en la notebook de la propietaria. La PC
# fija del local no necesita nada de esto.

# ─── PC servidor (la fija, del local) ────────────────────────────────────────
# IP de la PC servidor en la red del local. Conviene que sea una IP fija
# reservada en el router (ver docs/sync_notebook.md), porque si cambia hay
# que actualizarla acá.
SERVIDOR_HOST=192.168.0.10
SERVIDOR_DB_PUERTO=5432
SERVIDOR_DB_NOMBRE=ceramica_db

# Usuario de SOLO LECTURA para el sync (no el usuario normal de la app).
# Se crea una única vez en la PC servidor — instrucciones en
# docs/sync_notebook.md. Nunca usar acá el usuario/contraseña de la app.
SERVIDOR_DB_USUARIO=notebook_sync
SERVIDOR_DB_PASSWORD=

# ─── Fotos de productos (opcional, muy recomendado) ──────────────────────────
# Carpeta compartida de la PC servidor donde están las fotos (su
# backend\media). La base guarda solo la RUTA de cada imagen, así que sin
# esto la notebook sincroniza el catálogo completo pero lo muestra con todas
# las fotos rotas.
#
# Para habilitarlo hay que compartir esa carpeta en la PC servidor —
# instrucciones en docs/sync_notebook.md, sección "Fotos de productos".
# Dejar vacío para omitir la copia de fotos (el sync de datos funciona igual).
SERVIDOR_MEDIA_UNC=\\DESKTOP-UAIGET9\media

# ─── Base de datos LOCAL de la notebook (el espejo) ──────────────────────────
# Se sobreescribe por completo en cada sincronización exitosa.
LOCAL_DB_NOMBRE=ceramica_db
LOCAL_DB_USUARIO=ceramica_user
LOCAL_DB_PASSWORD=
LOCAL_DB_PUERTO=5432

# ─── Binarios de PostgreSQL ───────────────────────────────────────────────────
# Carpeta con pg_dump.exe y psql.exe. Dejar vacío si ya están en el PATH.
PG_BIN_DIR=C:\Program Files\PostgreSQL\15\bin
